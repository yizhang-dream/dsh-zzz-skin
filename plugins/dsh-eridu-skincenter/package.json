{
  "name": "dsh-eridu-skincenter",
  "description": "新艾利都自研皮肤中心——39 张动态背景 + 233 枚代理人头像；服务端直读 ~/.dsh/skins，首屏由 index-inject 注入；客户端含背景装饰层渲染 + 宿主设置页「皮肤中心」section（v1.1 起并入设置对话框，撤独立入口）",
  "version": "1.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
