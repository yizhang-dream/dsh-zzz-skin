{
  "name": "dsh-eridu-skincenter",
  "displayName": "ZZZ",
  "description": "ZZZ · 绝区零皮肤插件：自包含官方主视觉静态背景、绳网窗体材质、233 枚代理人头像与按会话头像/壁纸选择。设置入口为 ZZZ，支持明暗主题与窄屏布局；可选原片视频皮肤单独本地导入，不随 npm 分发。",
  "version": "1.5.4",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "bundle/",
    "scripts/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1"
  },
  "scripts": {
    "build:bundle": "node scripts/build-bundle.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "prepack": "node scripts/build-bundle.mjs",
    "import:custom": "node scripts/import-custom-skins.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yizhang-dream/dsh-zzz-skin.git",
    "directory": "plugins/dsh-eridu-skincenter"
  },
  "homepage": "https://github.com/yizhang-dream/dsh-zzz-skin/tree/main/plugins/dsh-eridu-skincenter#readme",
  "bugs": {
    "url": "https://github.com/yizhang-dream/dsh-zzz-skin/issues"
  },
  "author": {
    "name": "flower-moon"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-skin",
    "zzz",
    "zenless-zone-zero",
    "skin-center",
    "theme",
    "zenless"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
