{
  "name": "dsh-eridu-skincenter",
  "description": "ZZZ · 绝区零皮肤插件：37 套原片动态背景、代理人头像、敲敲会话联系人与界面材质。设置入口为 ZZZ，支持明暗主题与窄屏布局。",
  "version": "1.3.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
